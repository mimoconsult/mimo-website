<!doctype html>
<html lang="zh-Hant-TW">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }}｜{% endif %}明墨管理顧問</title>
<meta name="description" content="{{ summary or '明墨管理顧問 MIMO CONSULTANTS LIMITED：全齡財商教育，為小朋友、大小孩、上班族與長輩設計理財課程，提供企業內訓、演講與一對一諮詢陪跑。洞察如明，思富如墨。' }}">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta property="og:site_name" content="明墨管理顧問">
<meta property="og:type" content="{% if layout == 'article.njk' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or '明墨管理顧問' }}">
<meta property="og:description" content="{{ summary or '全齡財商教育：小朋友、大小孩、上班族與長輩的理財課程，企業內訓與一對一陪跑。洞察如明，思富如墨' }}">
{% if site.url %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/og-default.png">{% endif %}
<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;700&display=swap">
<link rel="stylesheet" href="/assets/style.css">
<script>(function(){var d=document.documentElement;try{if(!sessionStorage.getItem("mimoSun")){d.classList.add("sun-play");sessionStorage.setItem("mimoSun","1")}}catch(e){d.classList.add("sun-play")}})();</script>
</head>
<body>
<header><div class="wrap bar">
<a class="brand" href="/" aria-label="明墨管理顧問 首頁"><svg viewBox="0 0 120 120" aria-hidden="true" focusable="false"><defs><clipPath id="hm"><circle cx="60" cy="62" r="44"/></clipPath></defs><g clip-path="url(#hm)"><polygon points="40,120 82,50 126,120" fill="#8E8B84"/><polygon class="mk-ink" points="-2,120 44,38 92,120" fill="#2E3135"/></g><circle class="mk-ring" cx="60" cy="62" r="44" fill="none" stroke="#2E3135" stroke-width="3"/><circle class="sun-c" cx="88" cy="28" r="16" fill="#C9A45C" stroke="#F7F4EC" stroke-width="6"/></svg><span><b>明墨管理顧問</b><small>MIMO CONSULTANTS LIMITED</small></span></a>
<nav aria-label="主選單"><ul><li><a href="/articles/">財商資料庫</a></li><li><a href="/#kids">課程服務</a></li><li><a href="/about/">關於明墨</a></li><li class="jr-li"><a class="jr-btn" href="/junior/">小朋友版</a></li><li><a class="cta-s" href="/contact/">聯絡我們</a></li></ul></nav>
</div></header>
<main id="top">
{{ content | safe }}
</main>
<footer><div class="wrap">
<div class="fmap">
<div class="fb"><b>明墨管理顧問</b><span>洞察如明，思富如墨</span></div>
<div><h4>課程服務</h4><ul>{% for c in concepts %}<li><a href="{{ c.href }}">{{ c.title }}</a></li>{% endfor %}</ul></div>
<div><h4>學習資源</h4><ul><li><a href="/articles/">財商資料庫</a></li><li><a href="/junior/">小朋友版</a></li></ul></div>
<div><h4>明墨</h4><ul><li><a href="/about/">關於明墨</a></li><li><a href="/contact/">聯絡我們</a></li></ul></div>
</div>
<div class="fbot"><span>© 2026 明墨管理顧問</span><span>版權所有</span></div>
</div></footer>
<script>
document.querySelectorAll('.copy').forEach(function(b){b.addEventListener('click',function(){var t=b.dataset.copy;var done=function(){b.textContent='已複製';setTimeout(function(){b.textContent='複製'},1600)};
try{navigator.clipboard.writeText(t).then(done,function(){b.textContent=t})}catch(e){b.textContent=t}})});
</script>
<script>
(function(){var s=document.querySelector(".brand .sun-c");if(s)s.addEventListener("animationend",function(e){if(e.animationName==="hop")document.documentElement.classList.remove("sun-play")});})();
</script>
<script>
(function(){
(function(){var nav=performance.getEntriesByType&&(performance.getEntriesByType('navigation')[0]||{}).type;if(nav==='back_forward')return;
function go(){try{var id=decodeURIComponent(location.hash.slice(1)),t=id&&document.getElementById(id);
if(t){t.scrollIntoView({block:'start'})}else if(!id){scrollTo(0,0);document.body.scrollIntoView({block:'start'})}}catch(e){}}
go();addEventListener('load',function(){setTimeout(go,60)},{once:true})})();
var P=[].slice.call(document.querySelectorAll('[data-bg]'));if(!P.length)return;
var R=document.documentElement,H=document.querySelector('header');R.classList.add('js-bg');
var hex=function(h){h=h.replace('#','');return [0,2,4].map(function(i){return parseInt(h.substr(i,2),16)})};
var C=P.map(function(p){return {el:p,bg:hex(p.dataset.bg),fg:p.dataset.fg}});
var busy=false;
function lum(c){return (0.299*c[0]+0.587*c[1]+0.114*c[2])/255}
function upd(){busy=false;var vh=innerHeight,i=0,k,r;
 var hb=H?H.getBoundingClientRect().bottom:64;
 for(k=0;k<C.length;k++){if(C[k].el.getBoundingClientRect().top<=(C[k].el.dataset.win==='top'?hb:vh*.35))i=k}
 var cur=C[i],nx=C[i+1],t=0;
 if(nx){r=nx.el.getBoundingClientRect().top;t=nx.el.dataset.win==='top'?(hb+vh*.3-r)/(vh*.3):(vh*.85-r)/(vh*.5);t=Math.min(1,Math.max(0,t));t=t*t*(3-2*t)}
 var c=nx?cur.bg.map(function(v,j){return v+(nx.bg[j]-v)*t}):cur.bg;
 R.style.setProperty('--bg','rgb('+c.map(Math.round).join(',')+')');
 var dark=lum(c)<.5;R.style.setProperty('--hfg',dark?'#F7F4EC':'#2E3135');R.classList.toggle('hdr-dark',dark);
 for(k=0;k<C.length;k++){C[k].el.style.opacity=(k===i&&nx&&C[k].el.classList.contains('panel')&&!C[k].el.classList.contains('c-hero'))?String(1-t*.88):''}
}
addEventListener('scroll',function(){if(!busy){busy=true;requestAnimationFrame(upd)}},{passive:true});
addEventListener('resize',upd);upd();
if('IntersectionObserver' in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.18});P.forEach(function(p){io.observe(p)})}else{P.forEach(function(p){p.classList.add('in')})}
})();
</script>
</body>
</html>
