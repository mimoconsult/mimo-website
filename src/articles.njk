---
layout: base.njk
title: 財商資料庫
permalink: /articles/
---
<div class="wrap">
<div class="page-head"><p class="eyebrow">理財知識</p><h1>財商資料庫</h1><p>理財與財務管理的觀念整理，依主題分類，不定期更新</p></div>
<section style="padding-top:48px">
<div class="kb-intro" style="grid-template-columns:1fr">
<div class="search"><label for="q">搜尋</label><input id="q" type="search" placeholder="輸入關鍵字，例如：預算、保險" autocomplete="off"></div>
</div>
<div class="chips" role="group" aria-label="依分類篩選">
<button class="chip" type="button" data-f="" aria-pressed="true">全部<small>{{ collections.articles.length }}</small></button>
{% for c in categories.categories %}<button class="chip" type="button" data-f="{{ c.slug }}" aria-pressed="false">{{ c.name }}<small>{{ collections.articles | countCat(c.name) }}</small></button>{% endfor %}
</div>
<div class="lv-filter" role="group" aria-label="依深淺篩選"><span class="lv-l">深淺</span>
<button class="lvb" type="button" data-l="" aria-pressed="true">全部</button>
{% for l in difficulty %}{% set lv = l.n %}<button class="lvb" type="button" data-l="{{ l.n }}" aria-pressed="false" title="{{ l.desc }}">{% include "lvl-icon.njk" %}{{ l.name }}<i>{{ l.label }}</i></button>{% endfor %}
</div>
<p class="lv-note">山腳：{{ difficulty[0].desc }}　山腰：{{ difficulty[1].desc }}　山頂：{{ difficulty[2].desc }}</p>
<p class="count" id="count" aria-live="polite"></p>
<div class="alist" id="list">
{% for a in collections.articles %}{% include "card.njk" %}{% endfor %}
</div>
<p class="empty" id="none" hidden>找不到符合的文章，請換個關鍵字或分類</p>
</section>
</div>
<script>
(function(){
  var chips=[].slice.call(document.querySelectorAll('.chip[data-f]'));
  var cards=[].slice.call(document.querySelectorAll('#list .acard'));
  var q=document.getElementById('q'),count=document.getElementById('count'),none=document.getElementById('none');
  var cur=(location.hash||'').slice(1),lvCur='';var lvbs=[].slice.call(document.querySelectorAll('.lvb'));
  function apply(){
    var term=q.value.trim().toLowerCase(),n=0;
    cards.forEach(function(c){var ok=(!cur||c.dataset.cat===cur)&&(!lvCur||c.dataset.lv===lvCur)&&(!term||c.dataset.text.toLowerCase().indexOf(term)>-1);c.hidden=!ok;if(ok)n++;});
    chips.forEach(function(ch){ch.setAttribute('aria-pressed',String(ch.dataset.f===cur));});
    count.textContent='共 '+n+' 篇文章';none.hidden=n>0;
  }
  chips.forEach(function(ch){ch.addEventListener('click',function(){cur=ch.dataset.f;history.replaceState(null,'',cur?'#'+cur:location.pathname);apply();});});
  q.addEventListener('input',apply);
  lvbs.forEach(function(b){b.addEventListener('click',function(){lvCur=b.dataset.l;lvbs.forEach(function(x){x.setAttribute('aria-pressed',String(x===b))});apply();});});
  window.addEventListener('hashchange',function(){cur=location.hash.slice(1);apply();});
  apply();
})();
</script>
