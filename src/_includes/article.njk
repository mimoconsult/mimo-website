---
layout: base.njk
---
<div class="read-bar" aria-hidden="true"><i></i></div>
<div class="wrap"><article class="post">
<div class="meta">{% if category %}<a class="cat" href="/articles/#{{ category | catSlug(categories.categories) }}">{{ category }}</a>{% else %}<span class="eyebrow">文章</span>{% endif %}<time datetime="{{ page.date | isoDate }}">{{ page.date | twDate }}</time>{% if readTime %}<span>閱讀約 {{ readTime }} 分鐘</span>{% endif %}{% set lv = level or 1 %}{% include "lvl.njk" %}</div>
<h1>{{ title }}</h1>
{% if summary %}<p class="summary">{{ summary }}</p>{% endif %}
{% if hook %}<section class="hook" aria-label="這篇跟你有什麼關係">
<p class="hk-t">這篇跟你有什麼關係？</p>
<p class="hk-q">{{ hook.question }}</p>
{% if hook.text %}<p class="hk-x">{{ hook.text }}</p>{% endif %}
{% if hook.gain %}<div class="hk-g"><span>讀完你會知道</span><ul>{% for g in hook.gain %}<li>{{ g }}</li>{% endfor %}</ul></div>{% endif %}
</section>{% endif %}
{% if cover %}<img class="cover" src="{{ cover }}" alt="">{% endif %}
<div class="prose">{{ content | safe }}</div>
{% if takeaways %}<section class="take-box" aria-label="帶走這幾件事">
<p class="tb-t">帶走這{% if takeaways.length == 3 %}三{% else %}幾{% endif %}件事</p>
<ol>{% for t in takeaways %}<li>{{ t }}</li>{% endfor %}</ol>
</section>{% endif %}
<section class="share" aria-label="分享這篇文章">
<p class="sh-t">覺得有用　轉給需要的人</p>
<div class="sh-row">
<a class="sh sh-line" data-share="line" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3C6.5 3 2 6.6 2 11.1c0 4 3.6 7.4 8.4 8 .3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5s6.1-3.6 8.3-6.1c1.5-1.7 2.2-3.3 2.2-4.9C22 6.6 17.5 3 12 3z"/></svg>LINE</a>
<a class="sh sh-fb" data-share="fb" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5h2.5l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5H16.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"/></svg>Facebook</a>
<a class="sh sh-th" data-share="threads" href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" d="M16.6 11.3c-.4-2.3-2-3.5-4.3-3.5-2.6 0-4.1 1.8-4.1 4.2s1.6 4.1 4 4.1c2.2 0 3.9-1.3 3.9-3.3 0-2.6-3.5-2.9-5.2-2.1M18.8 7.4C17.4 4.7 15 3.5 12 3.5 7.2 3.5 4.2 6.9 4.2 12s3 8.5 7.8 8.5c3.8 0 6.8-2.2 6.8-5.6 0-1.9-1-3.4-2.9-4"/></svg>Threads</a>
<button class="sh sh-copy" type="button" data-share="copy"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg><span>複製連結</span></button>
<button class="sh sh-more" type="button" data-share="native" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" d="M12 15V3M8 7l4-4 4 4M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>更多</button>
</div>
</section>
<p class="post-next">想知道自己適合從哪裡開始？<a href="/courses/coaching/">看看一對一諮詢</a>或<a href="/contact/">直接問我們</a></p>
<a class="back" href="/articles/">← 回到財商資料庫</a>
</article>
<aside class="more-read"><h2>繼續閱讀</h2><div class="alist">{% for a in collections.articles | head(4) %}{% if a.url != page.url %}{% include "card.njk" %}{% endif %}{% endfor %}</div></aside>
</div>
<script>(function(){var u=location.href.split('#')[0],t=document.title.replace(/｜明墨管理顧問$/,''),e=encodeURIComponent;
var m={line:'https://social-plugins.line.me/lineit/share?url='+e(u),fb:'https://www.facebook.com/sharer/sharer.php?u='+e(u),threads:'https://www.threads.net/intent/post?text='+e(t+' '+u)};
document.querySelectorAll('.share [data-share]').forEach(function(a){var k=a.dataset.share;if(m[k])a.href=m[k];
if(k==='copy')a.addEventListener('click',function(){var s=a.querySelector('span'),d=function(){s.textContent='已複製';setTimeout(function(){s.textContent='複製連結'},1800)};try{navigator.clipboard.writeText(u).then(d,function(){prompt('複製這個連結',u)})}catch(x){prompt('複製這個連結',u)}});
if(k==='native'&&navigator.share){a.hidden=false;a.addEventListener('click',function(){navigator.share({title:t,url:u}).catch(function(){})})}});})();</script>
<script>(function(){var b=document.querySelector('.read-bar i'),a=document.querySelector('.post');if(!b||!a)return;function u(){var r=a.getBoundingClientRect(),h=r.height-innerHeight*.6,p=Math.min(1,Math.max(0,-r.top/(h>0?h:1)));b.style.transform='scaleX('+p+')'}addEventListener('scroll',u,{passive:true});addEventListener('resize',u);u()})();</script>
