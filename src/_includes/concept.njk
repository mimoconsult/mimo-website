---
layout: base.njk
---
<section class="panel c-hero in" data-bg="{{ bg }}" data-fg="{{ fg }}" style="--pbg:{{ bg }};--pfg:{{ fg }}">
<div class="p-in">
<p class="p-eye">{{ eyebrow }}</p>
<h1 class="p-h">{{ headline | safe }}</h1>
<p class="p-sub">{{ lead }}</p>
<ul class="c-quick" aria-label="{{ formatsTitle or '上課形式' }}">{% for f in formats %}<li>{{ f }}</li>{% endfor %}</ul>
<p class="p-links"><a href="#content">看課程內容</a><a href="/contact/">線上詢問</a></p>
</div>
<div class="p-ill">{% include "ill/" + ill + ".njk" %}</div>
</section>
<div id="content" data-bg="#F7F4EC" data-fg="#2E3135" data-win="top">
<div class="wrap c-body">
{% if intro %}<section class="c-sec" id="why"><h2>{{ introTitle or "為什麼要學" }}</h2><p class="c-lead">{{ intro }}</p></section>{% endif %}
{% if levels %}<section class="c-sec"><h2>{{ levelsTitle or "依年級設計" }}</h2><div class="c-grid">{% for l in levels %}<article class="c-card"><h3>{{ l.t }}</h3><p>{{ l.d }}</p></article>{% endfor %}</div></section>{% endif %}
<section class="c-sec"><h2>{{ topicsTitle or "課程內容" }}</h2><div class="c-grid">{% for t in topics %}<article class="c-card"><span class="no">0{{ loop.index }}</span><h3>{{ t.t }}</h3><p>{{ t.d }}</p></article>{% endfor %}</div></section>
<section class="c-sec"><h2>{{ formatsTitle or "上課形式" }}</h2><ul class="c-tags">{% for f in formats %}<li>{{ f }}</li>{% endfor %}</ul></section>
{{ content | safe }}
<section class="c-cta" style="background:{{ bg }};color:{{ fg }}">
<h2>{{ ctaTitle or "想進一步了解？" }}</h2>
<p>告訴我們對象、人數與想解決的問題，我們會提出合適的安排</p>
<p class="p-links"><a href="/contact/">線上詢問</a>{% if ctaExtra %}<a href="{{ ctaExtra.href }}">{{ ctaExtra.t }}</a>{% endif %}</p>
</section>
<nav class="c-next" aria-label="回到首頁的課程介紹">{% for c in concepts %}<a href="/#{{ c.key }}" style="background:{{ c.bg }};color:{{ c.fg }}"{% if c.key == ill %} aria-current="page"{% endif %}><small>{{ c.name }}</small><b>{{ c.title }}</b></a>{% endfor %}</nav>
</div>
</div>
